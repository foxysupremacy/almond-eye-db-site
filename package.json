{
	"name": "almond-eye-db-site",
	"version": "1.2.9",
	"private": true,
	"packageManager": "bun@1.3.10",
	"dependencies": {
		"@types/three": "^0.186.0",
		"@vinext/cloudflare": "latest",
		"react": "latest",
		"react-aria": "3.52.1",
		"react-aria-components": "1.21.1",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"react-stately": "3.50.0",
		"tesseract.js": "7.0.0",
		"three": "^0.186.0",
		"tw-animate-css": "^1.4.0",
		"vinext": "latest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "latest",
		"@happy-dom/global-registrator": "^20.14.5",
		"@react-aria/test-utils": "^1.0.0-rc.1",
		"@tailwindcss/postcss": "latest",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.4.0",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "latest",
		"wrangler": "^4.127.1"
	},
	"type": "module",
	"scripts": {
		"bump": "node --experimental-strip-types scripts/bump-version.ts",
		"build:data": "node --experimental-strip-types scripts/generate-data.ts && node --experimental-strip-types scripts/extract-mdb.ts",
		"data:build:pvp-recommendations": "node --experimental-strip-types scripts/build-pvp-recommendations.ts",
		"build:race-impact-priors": "node --experimental-strip-types scripts/build-race-impact-priors.ts",
		"data:refresh": "node --experimental-strip-types scripts/refresh-data.ts",
		"fetch:gametora": "node --experimental-strip-types scripts/fetch-gametora.ts",
		"dev": "vinext dev",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json",
		"deploy": "node --experimental-strip-types scripts/bump-version.ts && vinext build && vinext-cloudflare deploy --config dist/server/wrangler.json",
		"preview": "bun run build && bun run start",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
		"test": "bun test",
		"test:ui": "bun test --preload ./tests/dom/setup.ts ./tests/dom/*.interaction.tsx"
	}
}
